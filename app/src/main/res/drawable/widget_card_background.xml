<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯의 카드 바탕. Glance에는 테두리가 없고 모서리 깎기는 Android 12부터 되어 그림 하나로 깐다. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- AppColors.card -->
    <solid android:color="#FFFFFFFF" />
    <!-- AppDimens.widgetCardBorder, AppColors.border -->
    <stroke
        android:width="1dp"
        android:color="#FFE3E6EA" />
    <!-- AppDimens.widgetCardRadius -->
    <corners android:radius="16dp" />
</shape>
