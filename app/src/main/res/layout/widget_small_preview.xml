<?xml version="1.0" encoding="utf-8"?>
<!-- 작은 위젯의 미리 보기: 불장인 날의 판정 모습(시안의 첫 모습). 값은 위젯과 같다(공용 테마의 값). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background">

    <!-- 안쪽 여백: AppDimens.widgetSmallPaddingVertical, widgetSmallPaddingHorizontal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <!-- AppTypography.widgetSmallLine, AppColors.textMuted -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mood_now"
            android:textColor="#FF4A5360"
            android:textSize="12sp" />

        <!-- AppTypography.widgetSmallStage, AppColors.stageBull -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stage_bull"
            android:textColor="#FFC5221F"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- AppTypography.widgetSmallLine, AppColors.textMuted -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_as_of"
            android:textColor="#FF4A5360"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 버튼 자리: AppDimens.widgetSmallButtonWidth, widgetSmallButtonHeight, widgetSmallButtonTop, widgetSmallButtonEnd -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="2dp">

        <!-- 아이콘 그림 칸: AppDimens.widgetSmallIcon, 색: AppColors.textMuted -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="@string/action_refresh"
            android:src="@drawable/ic_widget_refresh"
            android:tint="#FF4A5360" />
    </FrameLayout>
</FrameLayout>
