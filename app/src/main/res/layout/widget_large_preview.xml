<?xml version="1.0" encoding="utf-8"?>
<!-- 큰 위젯의 미리 보기: 불장인 날의 판정 모습(시안의 첫 모습). 값은 위젯과 같다(공용 테마의 값). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background">

    <!-- 안쪽 여백: AppDimens.widgetLargePadding -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- AppTypography.widgetLargeTitle, AppColors.textMuted -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mood_now"
            android:textColor="#FF4A5360"
            android:textSize="13sp" />

        <!-- 첫 줄과 마지막 줄 사이의 가운데 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 단계 이름과 그 아래 매매 판단 두 줄을 한 묶음으로 세로 가운데에 둔다 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:orientation="vertical">

                <!-- AppTypography.widgetLargeStage, AppColors.stageBull -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stage_bull"
                    android:textColor="#FFC5221F"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <!-- 단계 이름과 두 줄 사이: AppDimens.widgetLargeValuationGap -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <!-- 매매 판단 줄: 이름 쪽 AppTypography.widgetValuationName, AppColors.textMuted /
                         사이 AppDimens.widgetValuationNameGap / 단계 쪽 AppTypography.widgetValuationStage, AppColors.valuationHigh -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/price_position_name"
                            android:textColor="#FF4A5360"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:maxLines="1"
                            android:text="@string/widget_preview_price_position_score"
                            android:textColor="#FFB45309"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 매매 판단 줄: 이름 쪽 AppTypography.widgetValuationName, AppColors.textMuted /
                         사이 AppDimens.widgetValuationNameGap / 단계 쪽 AppTypography.widgetValuationStage, AppColors.valuationHigh -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="@string/rate_burden_name"
                            android:textColor="#FF4A5360"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:maxLines="1"
                            android:text="@string/widget_preview_rate_burden_score"
                            android:textColor="#FFB45309"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- AppTypography.widgetLargeFooter, AppColors.textMuted -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_as_of"
            android:textColor="#FF4A5360"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 버튼 자리: AppDimens.widgetLargeButtonWidth, widgetLargeButtonHeight, widgetLargeButtonTop, widgetLargeButtonEnd -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp">

        <!-- 아이콘 그림 칸: AppDimens.widgetLargeIcon, 색: AppColors.textMuted -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@string/action_refresh"
            android:src="@drawable/ic_widget_refresh"
            android:tint="#FF4A5360" />
    </FrameLayout>
</FrameLayout>
